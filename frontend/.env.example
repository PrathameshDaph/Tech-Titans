# EventFlow AI - Environment Configuration

# 1. Google Maps JavaScript API Key (Optional but recommended for full maps rendering)
# Get a key from: https://console.cloud.google.com/google/maps-apis/overview
VITE_GOOGLE_MAPS_API_KEY=

# 2. Backend Engine API & WebSocket URLs (Optional - defaults to http://127.0.0.1:8000 for local dev)
# For production deployed backend (e.g. Render, Railway, AWS):
# VITE_API_URL=https://your-eventflow-backend.onrender.com
# VITE_WS_URL=wss://your-eventflow-backend.onrender.com/ws/telemetry
